# 复制成 .env 再填真实值：  copy .env.example .env
# 【不要把真实密钥填在本文件里】—— 本文件受 git 跟踪，会被提交。

# ── Worker (W) —— 实际部署时放 GitHub Secrets ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 是否启用 AI（预筛 + 提炼）
#   true （默认）需要 ANTHROPIC_API_KEY。简报由模型提炼成要点，质量好。
#                成本参考：1 个关键词每次 3 条，约 $0.73/月，$5 能用约 7 个月。
#   false        完全不需要 API Key，也不花钱。简报退化成「按标题列出」，
#                约等于 V1 的内容质量，但数据结构仍是完整的 V2。
# 全文照常归档，所以以后想开 AI，可拿存档重新生成历史简报，不用重抓。
AI_ENABLED=true
ANTHROPIC_API_KEY=

# 配图存哪儿：supabase（默认，无需额外账号）或 r2
# 90 天保留下，10 个关键词稳态也才约 527MB，在 Supabase 免费的 1GB 以内。
IMAGES_BACKEND=supabase

# 只有 IMAGES_BACKEND=r2 时才需要（R2 开通要绑支付卡）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_IMAGES=images

# 可选，留空用 config.py 里的默认值
MODEL_SCREEN=
MODEL_DISTILL=
MAX_FETCH_PER_RUN=
MAX_TOKENS_PER_RUN=
MAX_IMAGES_PER_ITEM=
MAX_IMAGE_BYTES=

# ── 应用 API (A) —— 实际部署时放 Vercel 环境变量 ──
# SUPABASE_SERVICE_KEY 绝不可加 NEXT_PUBLIC_ 前缀
APP_PASSWORD=
SESSION_SECRET=
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=
GITHUB_REF=main
USER_TZ=Asia/Kuala_Lumpur
