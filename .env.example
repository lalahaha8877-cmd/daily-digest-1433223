# ── Worker (W) —— 实际部署时放 GitHub Secrets，不要提交真实值 ──
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 配图存哪儿：supabase（默认，无需额外账号）或 r2
# 起步阶段用 supabase 就够：90 天保留下，10 个关键词的稳态也才约 527MB，
# 在 Supabase 免费的 1GB 以内。关键词上到两位数、或大量使用收藏之后再考虑 r2。
IMAGES_BACKEND=supabase

# 只有 IMAGES_BACKEND=r2 时才需要下面四项（R2 开通要绑支付卡）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_IMAGES=images

# 可选，留空用 config.py 里的默认值
MODEL_SCREEN=
MODEL_DISTILL=
MAX_FETCH_PER_RUN=
MAX_TOKENS_PER_RUN=
MAX_IMAGES_PER_ITEM=
MAX_IMAGE_BYTES=

# ── 应用 API (A) —— 实际部署时放 Vercel 环境变量 ──
# SUPABASE_SERVICE_KEY / R2_SECRET_ACCESS_KEY 绝不可加 NEXT_PUBLIC_ 前缀
APP_PASSWORD=
SESSION_SECRET=
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=
GITHUB_REF=main
USER_TZ=Asia/Kuala_Lumpur
